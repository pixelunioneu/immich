{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": false,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "lib": ["dom", "esnext"],
    // Deliberately mirrors server/tsconfig.json for the shared subset: this package
    // typechecks server sources it reuses, so a schema change that breaks the front
    // door has to fail the build here the same way it would there.
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      // Server sources import each other as `src/...`, so this alias has to point at
      // the server package for those imports to resolve. Frontdoor's own modules use
      // relative imports and never go through it.
      "src/*": ["../../server/src/*"],
      // The bundled SyncService is constructed against the shim BaseService (see
      // vite.config.ts), so the typecheck must see the same constructor. The other
      // shims only swap runtime behaviour; their real modules are typechecked as-is,
      // which is why the NestJS packages appear as devDependencies.
      "src/services/base.service": ["./src/shims/base.service.ts"],
      // The medium specs use the server's test harness the same way.
      "test/*": ["../../server/test/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2024"
  },
  // test/medium runs on the server's own vitest harness (see mise.toml) and
  // imports its test factories, which reach the whole server graph; that graph
  // is typechecked by the server package, not here.
  "exclude": ["dist", "node_modules", "vite.config.ts", "test/medium"],
  "include": ["src/**/*", "test/**/*"]
}
